# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
e2e/.auth/
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul

.gstack/

# Veo 원본 영상 (재생성 가능 — 리포 제외)
assets-src/video/

# 배경화면 원본 (재생성 가능 — 배포본은 public/wallpapers/*.webp)
assets-src/wallpapers/

# 토스 심사 문서 빌드 산출물 (원본은 md + images/)
docs/toss-review/*.html
docs/toss-review/*.pdf
